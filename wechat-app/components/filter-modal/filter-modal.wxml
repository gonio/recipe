<!-- 菜系筛选弹窗组件 -->
<view class="filter-modal {{show ? 'show' : ''}}" catchtouchmove="preventTouchMove">
  <!-- 遮罩层 -->
  <view class="mask" bindtap="onClose"></view>

  <!-- 弹窗内容 -->
  <view class="modal-content">
    <view class="modal-header">
      <text class="modal-title">选择菜系</text>
      <view class="close-btn" bindtap="onClose">
        <image src="/images/close.png" mode="aspectFit" />
      </view>
    </view>

    <!-- 菜系列表 -->
    <view class="cuisine-list">
      <view
        class="cuisine-item {{selectedCuisine === item ? 'active' : ''}}"
        wx:for="{{cuisines}}"
        wx:key="*this"
        bindtap="onSelectCuisine"
        data-cuisine="{{item}}"
      >
        <text>{{item}}</text>
      </view>
    </view>

    <!-- 底部按钮 -->
    <view class="modal-footer">
      <view class="reset-btn" bindtap="onReset">
        <text>重置</text>
      </view>
      <view class="confirm-btn" bindtap="onConfirm">
        <text>确定</text>
      </view>
    </view>
  </view>
</view>
