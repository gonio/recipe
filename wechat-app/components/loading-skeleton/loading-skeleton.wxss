/* 骨架屏组件样式 - 浅蓝色主题 */

.skeleton-container {
  width: 100%;
}

/* 闪烁动画 */
.shimmer {
  background: linear-gradient(
    90deg,
    #f0f4f8 25%,
    #e8eef4 50%,
    #f0f4f8 75%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 8rpx;
}

@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

/* 列表模式 */
.skeleton-list {
  padding: 24rpx;
}

.skeleton-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(66, 165, 245, 0.08);
}

.skeleton-image {
  width: 100%;
  height: 320rpx;
  border-radius: 0;
}

.skeleton-content {
  padding: 24rpx;
}

.skeleton-title {
  width: 70%;
  height: 40rpx;
  margin-bottom: 20rpx;
  border-radius: 8rpx;
}

.skeleton-meta {
  width: 50%;
  height: 28rpx;
  margin-bottom: 16rpx;
  border-radius: 6rpx;
}

.skeleton-footer {
  width: 30%;
  height: 28rpx;
  border-radius: 6rpx;
}

/* 详情模式 */
.skeleton-detail {
  padding: 0;
}

.skeleton-detail-image {
  width: 100%;
  height: 400rpx;
  border-radius: 0;
}

.skeleton-detail-content {
  padding: 32rpx;
}

.skeleton-detail-title {
  width: 60%;
  height: 48rpx;
  margin-bottom: 32rpx;
  border-radius: 8rpx;
}

.skeleton-detail-section {
  width: 100%;
  height: 120rpx;
  margin-bottom: 24rpx;
  border-radius: 12rpx;
}

/* 行模式 */
.skeleton-rows {
  padding: 24rpx;
}

.skeleton-row {
  width: 100%;
  height: 80rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
}
