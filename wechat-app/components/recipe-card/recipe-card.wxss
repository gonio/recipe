/* 菜谱卡片组件样式 - 浅蓝色主题 */

.recipe-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(66, 165, 245, 0.12);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  margin-bottom: 24rpx;
}

.card-hover {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 30rpx rgba(66, 165, 245, 0.2);
}

/* 图片容器 */
.image-container {
  position: relative;
  width: 100%;
  height: 320rpx;
  background: #f0f4f8;
}

.recipe-image {
  width: 100%;
  height: 100%;
  display: block;
}

/* 热门标签 */
.heat-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 107, 0.3);
}

.heat-text {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

/* 收藏按钮 */
.favorite-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.15s ease, background 0.2s ease;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

.btn-hover {
  transform: scale(0.9);
}

.favorite-icon {
  width: 40rpx;
  height: 40rpx;
  filter: drop-shadow(0 1rpx 2rpx rgba(0, 0, 0, 0.2));
}

/* 菜谱信息区 */
.recipe-info {
  padding: 24rpx;
}

.recipe-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  line-height: 1.4;
  display: block;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 元信息行 */
.meta-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.cuisine-tag {
  font-size: 24rpx;
  color: #42A5F5;
  font-weight: 500;
}

.divider {
  width: 2rpx;
  height: 20rpx;
  background: #e0e6ed;
  margin: 0 16rpx;
}

.cook-time,
.difficulty {
  font-size: 24rpx;
  color: #666666;
}

/* 底部行 */
.bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.favorite-count {
  display: flex;
  align-items: center;
}

.small-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.count-text {
  font-size: 24rpx;
  color: #999999;
}

/* Market 标签 */
.market-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.market-tag.new {
  background: linear-gradient(135deg, #42A5F5 0%, #64B5F6 100%);
  color: #ffffff;
}

.market-tag.pick {
  background: linear-gradient(135deg, #FFD93D 0%, #FFED4A 100%);
  color: #333333;
}
