/* 搜索栏组件样式 - 浅蓝色主题 */

.search-bar-container {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #ffffff;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f0f7ff;
  border-radius: 36rpx;
  padding: 16rpx 24rpx;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.search-input-wrapper:focus-within {
  background: #ffffff;
  border-color: #42A5F5;
  box-shadow: 0 0 0 4rpx rgba(66, 165, 245, 0.15);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  height: 40rpx;
  line-height: 40rpx;
}

.placeholder {
  color: #999999;
  font-size: 28rpx;
}

.clear-btn {
  padding: 8rpx;
  margin-left: 8rpx;
}

.clear-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
}

.search-btn {
  margin-left: 20rpx;
  padding: 16rpx 28rpx;
  background: linear-gradient(135deg, #42A5F5 0%, #64B5F6 100%);
  border-radius: 32rpx;
}

.search-btn text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}
