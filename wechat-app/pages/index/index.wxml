<!-- 首页 - 菜谱浏览 -->
<view class="container">
  <!-- 顶部欢迎区 -->
  <view class="header">
    <view class="header-left">
      <text class="greeting">{{greeting}}</text>
      <text class="subtitle">今天想吃点什么？</text>
    </view>
    <view class="header-right" bindtap="goToMarket">
      <image src="/images/market.png" mode="aspectFit" class="market-icon" />
      <text class="market-text">Market</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <search-bar
    placeholder="搜索菜谱名称..."
    value="{{searchKeyword}}"
    bind:input="onSearchInput"
    bind:search="onSearch"
    bind:clear="onSearchClear"
  />

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <scroll-view scroll-x class="cuisine-scroll" enhanced show-scrollbar="{{false}}">
      <view class="cuisine-list">
        <view
          class="cuisine-tag {{selectedCuisine === 'all' ? 'active' : ''}}"
          bindtap="onSelectCuisine"
          data-cuisine="all"
        >
          <text>全部</text>
        </view>
        <view
          class="cuisine-tag {{selectedCuisine === item ? 'active' : ''}}"
          wx:for="{{['川菜', '粤菜', '湘菜', '鲁菜', '苏菜', '浙菜', '闽菜', '徽菜']}}"
          wx:key="*this"
          bindtap="onSelectCuisine"
          data-cuisine="{{item}}"
        >
          <text>{{item}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="filter-btn" bindtap="onShowFilter">
      <image src="/images/filter.png" mode="aspectFit" class="filter-icon" />
    </view>
  </view>

  <!-- 骨架屏 -->
  <loading-skeleton wx:if="{{showSkeleton}}" type="list" count="3" />

  <!-- 错误状态 -->
  <view class="error-state" wx:elif="{{error}}">
    <image src="/images/error.png" mode="aspectFit" class="error-icon" />
    <text class="error-text">{{error}}</text>
    <view class="retry-btn" bindtap="onRetry">
      <text>重新加载</text>
    </view>
  </view>

  <!-- 菜谱列表 -->
  <view class="recipe-list" wx:elif="{{recipes.length > 0}}">
    <recipe-card
      wx:for="{{recipes}}"
      wx:key="_id"
      recipe="{{item}}"
      isFavorited="{{false}}"
      bind:tapCard="onRecipeTap"
      bind:toggleFavorite="onToggleFavorite"
    />
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <image src="/images/empty-recipes.png" mode="aspectFit" class="empty-icon" />
    <text class="empty-title">还没有菜谱</text>
    <text class="empty-desc">去 Market 发现更多美味！</text>
    <view class="explore-btn" bindtap="goToMarket">
      <text>去探索</text>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="loading-footer" wx:if="{{!showSkeleton && recipes.length > 0}}">
    <view class="loading-more" wx:if="{{loadingMore}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>
    <view class="no-more" wx:elif="{{noMore}}">
      <text>—— 已经到底了 ——</text>
    </view>
  </view>
</view>

<!-- 筛选弹窗 -->
<filter-modal
  show="{{showFilterModal}}"
  selectedCuisine="{{selectedCuisine}}"
  bind:confirm="onSelectCuisine"
  bind:reset="onResetFilter"
  bind:close="onCloseFilter"
/>