/* 首页样式 - 浅蓝色主题 #42A5F5 */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f9ff 0%, #ffffff 200rpx);
  padding: 32rpx;
  padding-bottom: 48rpx;
}

/* 头部区域 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.greeting {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #888888;
}

.header-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  background: linear-gradient(135deg, #42A5F5 0%, #64B5F6 100%);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(66, 165, 245, 0.3);
}

.market-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
}

.market-text {
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 500;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  margin: 24rpx 0;
}

.cuisine-scroll {
  flex: 1;
  white-space: nowrap;
}

.cuisine-list {
  display: flex;
  padding: 8rpx 0;
}

.cuisine-tag {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background: #f0f7ff;
  border-radius: 36rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.cuisine-tag text {
  font-size: 26rpx;
  color: #666666;
}

.cuisine-tag.active {
  background: linear-gradient(135deg, #42A5F5 0%, #64B5F6 100%);
  border-color: #42A5F5;
  box-shadow: 0 4rpx 12rpx rgba(66, 165, 245, 0.3);
}

.cuisine-tag.active text {
  color: #ffffff;
  font-weight: 500;
}

.filter-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 50%;
  margin-left: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.filter-icon {
  width: 36rpx;
  height: 36rpx;
}

/* 菜谱列表 */
.recipe-list {
  margin-top: 24rpx;
}

/* 加载底部 */
.loading-footer {
  text-align: center;
  padding: 48rpx 0;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999999;
  font-size: 26rpx;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  border: 3rpx solid #f0f4f8;
  border-top-color: #42A5F5;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.no-more {
  color: #bbbbbb;
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #888888;
  margin-bottom: 48rpx;
}

.explore-btn {
  padding: 28rpx 64rpx;
  background: linear-gradient(135deg, #42A5F5 0%, #64B5F6 100%);
  border-radius: 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(66, 165, 245, 0.3);
}

.explore-btn text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 600;
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}

.error-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.error-text {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 48rpx;
}

.retry-btn {
  padding: 24rpx 56rpx;
  background: #f0f7ff;
  border-radius: 40rpx;
  border: 2rpx solid #42A5F5;
}

.retry-btn text {
  font-size: 28rpx;
  color: #42A5F5;
  font-weight: 500;
}
