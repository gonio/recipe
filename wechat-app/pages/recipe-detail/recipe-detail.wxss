/* 菜谱详情页样式 - 浅蓝色主题 #42A5F5 */

.container {
  min-height: 100vh;
  background: #f8fafc;
  padding-bottom: 140rpx;
}

/* 顶部大图区域 */
.hero-section {
  position: relative;
  width: 100%;
  height: 480rpx;
}

.hero-image {
  width: 100%;
  height: 100%;
  display: block;
}

.image-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.4), transparent);
}

.back-btn {
  position: absolute;
  top: 60rpx;
  left: 24rpx;
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  z-index: 10;
}

.back-btn image {
  width: 36rpx;
  height: 36rpx;
}

.hero-badge {
  position: absolute;
  top: 60rpx;
  right: 24rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
  z-index: 10;
}

.hero-badge text {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

/* 内容区域 */
.content-section {
  position: relative;
  margin-top: -40rpx;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 32rpx;
  z-index: 5;
}

/* 标题区 */
.title-section {
  margin-bottom: 32rpx;
}

.recipe-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a2e;
  line-height: 1.3;
  margin-bottom: 24rpx;
  display: block;
}

.meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  background: #f0f7ff;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
}

.meta-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}

.meta-item text {
  font-size: 24rpx;
  color: #42A5F5;
  font-weight: 500;
}

/* 标签 */
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  border-radius: 20rpx;
}

.tag text {
  font-size: 22rpx;
  color: #1976D2;
}

/* 统计区 */
.stats-section {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: linear-gradient(135deg, #f8fafc 0%, #f0f7ff 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #888888;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #e0e6ed;
}

/* 通用区块 */
.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
}

/* 食材列表 */
.ingredients-list {
  background: #f8fafc;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
}

.ingredient-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e8eef4;
}

.ingredient-item:last-child {
  border-bottom: none;
}

.ingredient-dot {
  width: 12rpx;
  height: 12rpx;
  background: linear-gradient(135deg, #42A5F5 0%, #64B5F6 100%);
  border-radius: 50%;
  margin-right: 20rpx;
}

.ingredient-text {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.5;
}

/* 步骤列表 */
.steps-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.step-item {
  display: flex;
  gap: 20rpx;
}

.step-number {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #42A5F5 0%, #64B5F6 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(66, 165, 245, 0.3);
}

.step-number text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.step-content {
  flex: 1;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 24rpx;
}

.step-text {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.8;
}

/* 来源信息 */
.source-section {
  background: linear-gradient(135deg, #f0f7ff 0%, #e3f2fd 100%);
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  text-align: center;
}

.source-label {
  display: block;
  font-size: 26rpx;
  color: #42A5F5;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.source-info {
  font-size: 22rpx;
  color: #888888;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx 48rpx;
  box-shadow: 0 -4rpx 30rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.share-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  padding: 16rpx;
  margin-right: 24rpx;
}

.share-btn image {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 8rpx;
}

.share-btn text {
  font-size: 22rpx;
  color: #666666;
}

.favorite-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #42A5F5 0%, #64B5F6 100%);
  padding: 28rpx 0;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(66, 165, 245, 0.3);
  transition: all 0.3s ease;
}

.favorite-btn.active {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.3);
}

.favorite-btn image {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

.favorite-btn text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 600;
}

/* 错误状态 */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 48rpx;
}

.error-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.error-text {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 48rpx;
}

.retry-btn {
  padding: 24rpx 56rpx;
  background: #f0f7ff;
  border-radius: 40rpx;
  border: 2rpx solid #42A5F5;
}

.retry-btn text {
  font-size: 28rpx;
  color: #42A5F5;
  font-weight: 500;
}
