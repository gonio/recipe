<!-- 菜谱详情页 -->
<view class="container">
  <!-- 骨架屏 -->
  <loading-skeleton wx:if="{{isLoading}}" type="detail" />

  <!-- 错误状态 -->
  <view class="error-state" wx:elif="{{error}}">
    <image src="/images/error.png" mode="aspectFit" class="error-icon" />
    <text class="error-text">{{error}}</text>
    <view class="retry-btn" bindtap="onRetry">
      <text>重新加载</text>
    </view>
  </view>

  <!-- 菜谱详情内容 -->
  <block wx:elif="{{recipe}}">
    <!-- 顶部图片 -->
    <view class="hero-section">
      <image
        class="hero-image"
        src="{{recipe.imageUrl || '/images/default-recipe.png'}}"
        mode="aspectFill"
        bindtap="previewImage"
        lazy-load
      />
      <view class="image-overlay"></view>

      <!-- 返回按钮 -->
      <view class="back-btn" bindtap="goBack">
        <image src="/images/arrow-left-white.png" mode="aspectFit" />
      </view>

      <!-- 热门标签 -->
      <view class="hero-badge" wx:if="{{recipe.heatScore > 50}}">
        <text>热门菜谱</text>
      </view>
    </view>

    <!-- 内容区域 -->
    <view class="content-section">
      <!-- 标题区 -->
      <view class="title-section">
        <text class="recipe-name">{{recipe.name}}</text>

        <view class="meta-row">
          <view class="meta-item">
            <image src="/images/cuisine.png" mode="aspectFit" class="meta-icon" />
            <text>{{recipe.cuisine}}</text>
          </view>
          <view class="meta-item">
            <image src="/images/time.png" mode="aspectFit" class="meta-icon" />
            <text>{{recipe.cookTimeText}}</text>
          </view>
          <view class="meta-item">
            <image src="/images/difficulty.png" mode="aspectFit" class="meta-icon" />
            <text>{{recipe.difficultyText}}</text>
          </view>
        </view>

        <!-- 标签 -->
        <view class="tags-row" wx:if="{{recipe.tags && recipe.tags.length > 0}}">
          <view class="tag" wx:for="{{recipe.tags}}" wx:key="*this">
            <text>{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 统计信息 -->
      <view class="stats-section">
        <view class="stat-item">
          <text class="stat-value">{{recipe.favoriteCount || 0}}</text>
          <text class="stat-label">收藏</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{recipe.viewCount || 0}}</text>
          <text class="stat-label">浏览</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{recipe.heatScore ? Math.round(recipe.heatScore) : 0}}</text>
          <text class="stat-label">热度</text>
        </view>
      </view>

      <!-- 食材列表 -->
      <view class="section" wx:if="{{recipe.ingredients && recipe.ingredients.length > 0}}">
        <view class="section-header">
          <image src="/images/ingredients.png" mode="aspectFit" class="section-icon" />
          <text class="section-title">食材准备</text>
        </view>
        <view class="ingredients-list">
          <view class="ingredient-item" wx:for="{{recipe.ingredients}}" wx:key="index">
            <view class="ingredient-dot"></view>
            <text class="ingredient-text">{{item.name}} {{item.amount}}</text>
          </view>
        </view>
      </view>

      <!-- 烹饪步骤 -->
      <view class="section" wx:if="{{recipe.steps && recipe.steps.length > 0}}">
        <view class="section-header">
          <image src="/images/steps.png" mode="aspectFit" class="section-icon" />
          <text class="section-title">烹饪步骤</text>
        </view>
        <view class="steps-list">
          <view class="step-item" wx:for="{{recipe.steps}}" wx:key="index">
            <view class="step-number">
              <text>{{index + 1}}</text>
            </view>
            <view class="step-content">
              <text class="step-text">{{item}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 来源信息 -->
      <view class="source-section" wx:if="{{recipe.sourceType === 'ai_curated' && recipe.aiSource}}">
        <text class="source-label">AI 智能推荐</text>
        <text class="source-info">由 {{recipe.aiSource.modelUsed === 'hunyuan' ? '混元' : 'DeepSeek'}} 模型生成</text>
      </view>
    </view>
  </block>
</view>

<!-- 底部操作栏 -->
<view class="bottom-bar" wx:if="{{recipe}}">
  <view class="share-btn" bindtap="onShareAppMessage">
    <image src="/images/share.png" mode="aspectFit" />
    <text>分享</text>
  </view>

  <view class="favorite-btn {{isFavorited ? 'active' : ''}}" bindtap="toggleFavorite">
    <image
      src="{{isFavorited ? '/images/heart-filled-white.png' : '/images/heart-outline-white.png'}}"
      mode="aspectFit"
    />
    <text>{{isFavorited ? '已收藏' : '收藏'}}</text>
  </view>
</view>
