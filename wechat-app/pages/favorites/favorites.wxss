/* 我的收藏页面样式 */

.container {
  min-height: 100vh;
  background: #F5F9FF;
  padding: 24rpx;
}

/* 收藏列表头部 */
.favorites-header {
  margin-bottom: 24rpx;
}

.favorites-count {
  font-size: 26rpx;
  color: #666666;
}

/* 收藏列表 */
.favorites-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 加载更多 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  gap: 16rpx;
}

.loading-more text {
  font-size: 26rpx;
  color: #999999;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #E3F2FD;
  border-top-color: #42A5F5;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 到底提示 */
.no-more {
  text-align: center;
  padding: 40rpx;
}

.no-more text {
  font-size: 24rpx;
  color: #999999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 48rpx;
}

.empty-icon {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #888888;
  text-align: center;
  margin-bottom: 48rpx;
}

.explore-btn {
  background: linear-gradient(135deg, #42A5F5 0%, #64B5F6 100%);
  padding: 28rpx 64rpx;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(66, 165, 245, 0.3);
}

.explore-btn text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 600;
}
